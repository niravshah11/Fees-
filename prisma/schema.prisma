// Fountainhead Group Fee Management — persistence.
// Postgres locally via `docker compose up -d` (serves on 5440, see docker-compose.yml);
// DATABASE_URL is set in .env. Same conventions as the event-management prototype:
//
// Status/role fields are String (not Prisma enums) + validated by the TS union types in
// engine/*.ts — the engines are the source of truth for those unions, and re-typing them as
// native enums buys nothing the tests don't already cover.
//
// DateTime columns are timezone-naive TIMESTAMP(3) (Prisma's default). Prisma Client's own writes
// (@default(now()), @updatedAt) are always a true UTC instant regardless of the Postgres
// session's TimeZone setting, so that's safe. Any FUTURE migration that seeds createdAt/updatedAt
// via raw SQL must use `(now() AT TIME ZONE 'UTC')`, not bare CURRENT_TIMESTAMP — see the
// event-management app's 20260819120000_fix_raw_seed_timestamp_skew for the full story.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One of the six Fountainhead schools this app covers. Seeded once from lib/school-config.ts;
/// editable only by a rights admin (there's no per-school "edit school" UI in v1 — code/name/board
/// changes are rare enough to do via the seed/a migration).
model School {
  id             String           @id @default(cuid())
  code           String           @unique // FSK | FSM | FWGS | FPV | FPA | FALH
  name           String
  board          String // e.g. "IB"
  domain         String // school's staff email domain, for rights-grant defaults only
  order          Int              @default(0)
  programmeStages ProgrammeStage[]
  gradeBands     GradeBand[]
  feeHeads       FeeHead[]
  feeVersions    FeeVersion[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

/// A programme grouping within a school (e.g. FSK's EYP/PYP/MYP/DP) — pure structure (which
/// grade bands belong to which programme), managed at /master. Deliberately carries NO rate:
/// the YoY increment % is a fresh decision every year, made per grade band when a Finance
/// Officer builds that year's draft (FeeLine.incrementPct, or the draft editor's "bulk apply"),
/// not a stored default here — confirmed with the user (school fee structures and increment
/// policy both vary too much year to year and campus to campus to bake a rate into the master
/// structure).
model ProgrammeStage {
  id         String      @id @default(cuid())
  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId   String
  label      String // e.g. "EYP — Early Years Programme"
  order      Int         @default(0)
  gradeBands GradeBand[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([schoolId])
}

/// A grade/programme band within a school (e.g. "Jr. & Sr. KG", "Grade 1 to 6"). Belongs to
/// exactly one ProgrammeStage, which determines its default YoY increment.
model GradeBand {
  id               String         @id @default(cuid())
  school           School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId         String
  programmeStage   ProgrammeStage @relation(fields: [programmeStageId], references: [id], onDelete: Cascade)
  programmeStageId String
  label            String // e.g. "Jr. & Sr. KG"
  order            Int            @default(0)
  feeLines         FeeLine[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([schoolId])
  @@index([programmeStageId])
}

/// A fee category a school charges, beyond just tuition — e.g. FSK's "Tuition Fee" and "Beyond
/// Mandatory Fee". Campus-specific and extensible via Master Data (confirmed with the user: each
/// campus can have a different set of heads, and new ones get added as the need arises), not a
/// fixed global list of columns.
model FeeHead {
  id        String    @id @default(cuid())
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  label     String // e.g. "Tuition Fee", "Beyond Mandatory Fee"
  order     Int       @default(0)
  /// True for a head whose own amount already IS the grade band's grand total (e.g. FSK/FSM's
  /// "Total Fees to be charged from Parents") — at most one per school, confirmed with the user.
  /// When present, display code uses this head's amount as the total instead of summing every
  /// head (Total Fees, Tuition Fee, and Beyond Mandate are each independently entered — the app
  /// does not enforce Total = Tuition + Beyond Mandate).
  isTotal   Boolean   @default(false)
  feeLines  FeeLine[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([schoolId])
}

/// One fee proposal for one school for one academic year. Grain: school x academicYear x attempt
/// — a school can have several FeeVersion rows for the same year across revision cycles, but only
/// one may be APPROVED at a time (enforced in app/schools/[code]/actions.ts's approve action,
/// which flips any prior APPROVED row for the same school+year to SUPERSEDED — Postgres has no
/// partial-unique-index support in Prisma's schema DSL, so this is an app-level invariant).
model FeeVersion {
  id           String         @id @default(cuid())
  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId     String
  academicYear String // e.g. "2027-28"
  // DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | SUPERSEDED (engine/fee.ts)
  status       String         @default("DRAFT")
  createdBy    String? // email, provenance only
  submittedAt  DateTime?
  notes        String?
  feeLines     FeeLine[]
  approvals    FeeApproval[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([schoolId])
  @@index([academicYear])
  @@index([status])
}

/// One grade band's proposed amount for ONE fee head within a FeeVersion — grain is version x
/// grade band x fee head. `incrementPct` is editable per row, independently per head: FSK's
/// "Beyond Mandatory Fee" can grow at a different YoY % than its "Tuition Fee" for the same grade
/// band (confirmed with the user — each head is its own base/increment/amount, not a shared
/// rate). A grade band's headline total is the SUM of its FeeLine.amount across every head for
/// that version, computed at display time (engine/fee.ts's computeTotalFee), not stored.
model FeeLine {
  id            String     @id @default(cuid())
  feeVersion    FeeVersion @relation(fields: [feeVersionId], references: [id], onDelete: Cascade)
  feeVersionId  String
  gradeBand     GradeBand  @relation(fields: [gradeBandId], references: [id], onDelete: Cascade)
  gradeBandId   String
  feeHead       FeeHead    @relation(fields: [feeHeadId], references: [id], onDelete: Cascade)
  feeHeadId     String
  baseFee       Int // prior approved year's amount for this head (or a manually entered anchor for a school's first year)
  incrementPct  Decimal    @db.Decimal(6, 4)
  amount        Int // computed: computeIncrementedFee(baseFee, incrementPct) — stored for audit
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([feeVersionId, gradeBandId, feeHeadId])
  @@index([feeVersionId])
  @@index([gradeBandId])
  @@index([feeHeadId])
}

/// One step in a fee version's Fees Group Coordinator -> Head of Operations -> Director -> Board
/// of Trustees approval chain (engine/approval.ts). Same shape as the event-management app's
/// TripApproval — this row IS the audit trail.
model FeeApproval {
  id           String     @id @default(cuid())
  feeVersion   FeeVersion @relation(fields: [feeVersionId], references: [id], onDelete: Cascade)
  feeVersionId String
  role         String // FEES_GROUP_COORDINATOR | HEAD_OF_OPERATIONS | DIRECTOR | BOARD_TRUSTEE
  label        String // display label, e.g. "Board of Trustees"
  order        Int // position in the chain (0-based)
  // PENDING | APPROVED | REJECTED
  status       String     @default("PENDING")
  decidedBy    String?
  decidedAt    DateTime?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([feeVersionId])
}

model AppUser {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  rights    AppUserRight[]
}

/// Who holds which fee-workflow role where. Unlike the event-management app's flat AppUserRight
/// (existence = permission), fee approval genuinely needs distinct capability tiers, so this row
/// carries a `role` alongside `campus`. `role: SCHOOL_FINANCE` is meaningfully campus-scoped
/// (drafts/edits/submits one school's proposal); the four approval-chain roles (Fees Group
/// Coordinator, Head of Operations, Director, Board of Trustees) act on their chain step for
/// every school, so their rows are always campus: null in practice, though the field stays
/// nullable-string for symmetry with the event-management app's pattern.
/// No DB-level unique constraint on (userId, role, campus), deliberately — same trap as the
/// event-management app's AppUserRight doc comment: Postgres never treats two NULLs as equal, so
/// a composite unique can't dedupe campus-wide grants. Dedup is an app-level check on add.
model AppUserRight {
  id        String   @id @default(cuid())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String // SCHOOL_FINANCE | FEES_GROUP_COORDINATOR | HEAD_OF_OPERATIONS | DIRECTOR | BOARD_TRUSTEE (engine/rights.ts)
  campus    String? // School.code, or null = every school
  grantedBy String? // rights-admin's email — provenance only
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([campus])
}
