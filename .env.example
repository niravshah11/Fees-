# Local Postgres started by `docker compose up -d` (see docker-compose.yml).
DATABASE_URL="postgresql://fees:fees@localhost:5440/fees_management"
# On a machine without Docker available, point at any local Postgres instead, isolated in its
# own schema so it can't collide with another app's tables, e.g.:
# DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<existing_db>?schema=fees"

# Auth.js (NextAuth v5). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated email domain allowlist. Blank/unset = the hardcoded 8 Fountainhead org
# domains (lib/auth-domains.ts) — never "everyone" (see that file's header).
AUTH_ALLOWED_DOMAINS=""

# Comma-separated emails allowed to curate /settings/rights. Blank/unset = a single
# hardcoded fallback admin (lib/auth/rights-admins.ts) so the page is never unbootstrappable.
RIGHTS_ADMIN_EMAILS=""
